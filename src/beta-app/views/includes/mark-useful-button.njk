{% from "nhsuk/macros/icon.njk" import nhsukIcon %}

{% macro mark_useful_button(count, product_id, document_id, marked) %}

    <div class="nhsuk-u-margin-bottom-4">        
        <p class="nhsuk-body nhsuk-u-margin-bottom-2 useful-count" data-document-id="{{ document_id }}">
            {% if count > 0 %}
            {{ nhsukIcon("tick") }}
            <strong>{{count}} people</strong>
            found this useful
            {% endif %}
        </p>

        <button class="nhsuk-button nhsuk-button--secondary nhsuk-u-margin-bottom-0 mark-useful-button" data-module="nhsuk-button" aria-pressed="false" type="button" data-nhsuk-button-init="" data-product-id="{{ product_id }}" data-document-id="{{ document_id }}">
            {% if marked %}
                {{ nhsukIcon("tick") }} Marked as useful
            {% else %}
                Mark as useful
            {% endif %}
        </button>

    </div>
{% endmacro %}
