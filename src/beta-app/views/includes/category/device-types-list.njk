{% macro deviceTypesList(deviceTypes, category, subcategories) %}
        <div class="nhsuk-grid-row">

        {# Results first in the source, floated right (components/_side-nav.scss),
           so the h1 sits over the list it describes and is still the first
           heading screen readers meet. On mobile, the sidebar stacks below. #}
        <div class="{{ 'app-grid-column-two-thirds-right' if subcategories | length else 'nhsuk-grid-column-full' }}">

            <h1 class="nhsuk-heading-l nhsuk-u-margin-bottom-2" id="device-types"> {{deviceTypes | length}} device type{{ 's' if deviceTypes | length != 1 }} in
                {{ category.name }}</h1>

            <div data-module="app-paginated-table">

            <p class="nhsuk-body-s" data-pagination-status>Showing all {{ deviceTypes | length }}, ordered A to Z.</p>

            <table class="nhsuk-table" data-module="nhsuk-table">
                <caption class="nhsuk-table__caption nhsuk-u-visually-hidden">Device types in
                    {{ category.name }}</caption>
                <thead class="nhsuk-table__head">
                    <tr>
                        <th scope="col" class="nhsuk-table__header" aria-sort="ascending" data-sort>Device type</th>
                        <th scope="col" class="nhsuk-table__header nhsuk-table__header--numeric" data-sort>Suppliers</th>
                    </tr>
                </thead>
                <tbody class="nhsuk-table__body">
                    {% for deviceType in deviceTypes %}
                        <tr class="nhsuk-table__row">

                            <td class="nhsuk-table__cell">
                                <a href="/category/{{ category.nodeId }}/device-type/{{ deviceType.gmdnCode }}">{{ deviceType.gmdnTermName }}</a>
                            </td>

                            <td class="nhsuk-table__cell nhsuk-table__cell--numeric">{{ deviceType.supplierCount }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            <nav class="nhsuk-pagination nhsuk-pagination--numbered" role="navigation" aria-label="Pagination" data-pagination hidden></nav>

            </div>
        </div>

        {% if subcategories | length %}
            <div class="nhsuk-grid-column-one-third">
                <nav aria-labelledby="category-nav-heading">
                    <h2 class="app-side-nav__heading nhsuk-heading-s nhsuk-u-margin-bottom-3" id="category-nav-heading">{{ category.name }}</h2>
                    <ul class="app-side-nav__list">
                        {% for subcategory in subcategories %}
                            <li class="app-side-nav__item">
                                <a class="app-side-nav__link" href="/category/{{ subcategory.nodeId }}">{{ subcategory.name }}</a>
                                <span class="app-side-nav__count">({{ subcategory.deviceTypeCount }})</span>
                            </li>
                        {% endfor %}
                    </ul>
                </nav>
            </div>
        {% endif %}
    </div>
{% endmacro %}
