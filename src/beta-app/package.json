{
  "name": "nhsuk-compass-app",
  "version": "0.0.1",
  "description": "A digital service for NHS staff to search and evaluate medical technologies",
  "scripts": {
    "dev:css": "sass --load-path=node_modules --watch assets/sass:public/css --style=expanded",
    "dev:ts": "tsx watch --include './views/**/*.html' --env-file-if-exists .env index.ts",
    "dev": "npm-run-all --parallel dev:css dev:ts",
    "start": "node --env-file-if-exists .env dist/index.js",
    "build:css": "sass --load-path=node_modules assets/sass:public/css --style=compressed",
    "build": "npm run build:css && tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "medtech",
    "nhs",
    "compass",
    "procurement",
    "evaluation"
  ],
  "author": "https://github.com/register-dynamics",
  "type": "module",
  "dependencies": {
    "@types/nunjucks": "^3.2.6",
    "express": "^5.2.1",
    "nhsuk-frontend": "^10.6.0",
    "nunjucks": "^3.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node26": "^26.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/eslint-plugin": "^1.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-perfectionist": "^5.10.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^1.1.5"
  }
}
