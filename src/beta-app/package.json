{
  "name": "nhsuk-compass-app",
  "version": "0.0.1",
  "description": "A digital service for NHS staff to search and evaluate medical technologies",
  "scripts": {
    "dev:css": "sass --load-path=node_modules --watch assets/sass:public/css --style=expanded",
    "dev:js": "esbuild assets/js/nhsuk.ts --bundle --format=esm --minify --sourcemap --target=es2020 --tsconfig=tsconfig.json --outfile=public/javascripts/nhsuk-frontend.min.js --watch=forever",
    "dev:ts": "tsx watch --include './views/**/*.html' --include './views/**/*.njk' --env-file-if-exists .env index.ts",
    "dev:db": "docker compose up --build db -d",
    "dev": "npm run db:migrate && npm-run-all --parallel dev:css dev:js dev:ts",
    "start": "npm run db:migrate && node --env-file-if-exists .env dist/index.js",
    "build:css": "sass --load-path=node_modules assets/sass:public/css --style=compressed",
    "build:js": "esbuild assets/js/nhsuk.ts --bundle --format=esm --minify --sourcemap --target=es2020 --tsconfig=tsconfig.json --outfile=public/javascripts/nhsuk-frontend.min.js",
    "build": "npm run build:css && npm run build:js && tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:pa11y": "npm run generate:sitemap && pa11y-ci --config .pa11yci",
    "test:a11y": "npm-run-all --parallel --race dev test:pa11y",
    "test:all": "npm-run-all test:a11y test:e2e test:coverage",
    "generate:sitemap": "npm run build && node --env-file-if-exists .env scripts/generate-sitemap.mjs",
    "db:migrate": "tsx --env-file-if-exists .env scripts/apply-database-migrations.ts"
  },
  "keywords": [
    "medtech",
    "nhs",
    "compass",
    "procurement",
    "evaluation"
  ],
  "author": "https://github.com/register-dynamics",
  "type": "module",
  "dependencies": {
    "@types/nunjucks": "^3.2.6",
    "argon2": "^0.45.1",
    "connect-pg-simple": "^10.0.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "kysely": "^0.29.5",
    "nhsuk-frontend": "^10.6.0",
    "node-gyp": "^10.3.1",
    "nunjucks": "^3.2.4",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tsconfig/node26": "^26.0.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.2.0",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/eslint-plugin": "^1.0.0",
    "esbuild": "0.28.2",
    "eslint": "^10.8.1",
    "eslint-plugin-perfectionist": "^5.10.1",
    "npm-run-all": "^4.1.5",
    "pa11y-ci": "^4.1.1",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^1.1.5"
  }
}
