{
  "name": "nhsuk-compass-app",
  "version": "0.0.1",
  "description": "A digital service for NHS staff to search and evaluate medical technologies",
  "scripts": {
    "dev": "tsx --watch --env-file-if-exists .env index.ts",
    "start": "node --env-file-if-exists .env dist/index.js",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "medtech",
    "nhs",
    "compass",
    "procurement",
    "evaluation"
  ],
  "author": "https://github.com/register-dynamics",
  "type": "module",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node26": "^26.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-plugin-perfectionist": "^5.10.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
