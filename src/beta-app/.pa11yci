{
  "standard": "WCAG2AA",
  "defaults": {
    "chromeLaunchConfig": {
      "args": [
        "--no-sandbox",
        "--headless=new"
      ]
    },
    "useIncognitoBrowserContext": false,
    "reporters": [
      "cli",
      [
        "json",
        {
          "fileName": "./reports/pa11y-results.json"
        }
      ]
    ]
  },
  "urls": [
    {
      "__NOTE": "This should always be FIRST (to test the sign in page before actually signing in)",
      "url": "http://localhost:3001/sign-in"
    },
    {
      "__NOTE": "This should always be SECOND (if browser context is preserved) to authenticate the user",
      "url": "http://localhost:3001/sign-in",
      "actions": [
        "navigate to http://localhost:3001/sign-in",
        "wait for element .nhsuk-width-container to be visible",
        "set field #username to test@example.com",
        "set field #password to northsouth",
        "click element .nhsuk-button",
        "wait for path to be /dashboard"
      ]
    },
    "http://localhost:3001/",
    "http://localhost:3001/category/10027/device-type/14035",
    "http://localhost:3001/category/10027/device-type/14035/related-trusts",
    "http://localhost:3001/category/10027/device-type/14035/related-trusts/contract/FAKE0018",
    "http://localhost:3001/category/10027/device-type/14035/supplier/65283",
    "http://localhost:3001/category/10027/device-type/14035/supplier/65283/product/Thermometer%20tympanic%20device",
    "http://localhost:3001/category/10027/device-type/14035/supplier/65283/product/Thermometer%20tympanic%20device/related-trusts",
    "http://localhost:3001/category/10027/device-type/14035/supplier/65283/product/Thermometer%20tympanic%20device/trust/13",
    "http://localhost:3001/category/10027/device-type/14035/supplier/65283/product/Thermometer%20tympanic%20device/trust/6",
    "http://localhost:3001/category/10027/device-type/14035/supplier/65283/product/Thermometer%20tympanic%20device/trusts",
    "http://localhost:3001/category/10027/device-type/14035/supplier/65283/related-trusts",
    "http://localhost:3001/category/10027/device-type/14035/supplier/65283/trusts",
    "http://localhost:3001/category/10027/device-type/14035/trusts",
    "http://localhost:3001/category/4941",
    "http://localhost:3001/category/9990/device-type/35198/supplier/13455/product/Heart%20Rate%20Monitor/related-trusts/contract/FAKE0019",
    "http://localhost:3001/category/9990/device-type/35198/supplier/13455/related-trusts/contract/FAKE0019",
    "http://localhost:3001/dashboard",
    "http://localhost:3001/device-type/14035/supplier/65283",
    "http://localhost:3001/device-type/14035/supplier/65283/product/Thermometer%20tympanic%20device",
    "http://localhost:3001/device-type/14035/supplier/65283/product/Thermometer%20tympanic%20device/related-trusts",
    "http://localhost:3001/device-type/14035/supplier/65283/product/Thermometer%20tympanic%20device/trust/13",
