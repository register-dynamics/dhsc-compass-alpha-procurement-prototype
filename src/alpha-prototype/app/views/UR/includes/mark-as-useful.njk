{% from "button/macro.njk" import button %}

{# "Useful" endorsement count and action.
   The NHS Design System has no like/favourite component, so this uses a
   secondary button with the ARIA toggle button pattern (aria-pressed).
   Tick icon is decorative (aria-hidden); the count and the button label
   carry the meaning for assistive technology. #}
{% macro markAsUseful(count) %}
  <div class="nhsuk-u-margin-bottom-4">

    <p class="nhsuk-body nhsuk-u-margin-bottom-2">
      <svg class="nhsuk-icon nhsuk-icon__tick" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" focusable="false" aria-hidden="true" style="vertical-align: middle;">
        <path d="M11.4 18.8a2 2 0 0 1-2.7.1h-.1L4 14.1a1.5 1.5 0 0 1 2.1-2L10 16l8.1-8.1a1.5 1.5 0 1 1 2.2 2l-8.9 9Z"></path>
      </svg>
      <strong>{{ count | default(25) }} people</strong> found this useful
    </p>

    {{ button({
      element: "button",
      type: "button",
      text: "Mark as useful",
      classes: "nhsuk-button--secondary nhsuk-u-margin-bottom-0",
      attributes: {
        "id": "mark-useful",
        "aria-pressed": "false"
      }
    }) }}

  </div>
{% endmacro %}
